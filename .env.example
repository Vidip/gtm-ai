# Copy to .env and fill in, or export directly in your shell.
ANTHROPIC_API_KEY=

# Optional: override the model used for research (defaults to claude-sonnet-4-5)
OPPORTUNITY_RADAR_MODEL=claude-sonnet-4-5

# Optional: if set, the fetch_url tool uses Tavily Extract for higher-fidelity
# content extraction on targeted URLs. If unset (or a Tavily call fails), it
# falls back to a local requests+BeautifulSoup extractor automatically - no
# Tavily account is required to run the plugin.
TAVILY_API_KEY=tvly-...

# Set to false to never call Tavily even if a key is present (default: true).
TAVILY_ENABLED=true

# Max pages fetch_url may extract per company (Tavily or local). Empty/unset = no cap.
MAX_FETCH=10
